FROM ghcr.io/cloudnative-pg/postgresql:17

ARG TIMESCALE_VERSION=2.25.1
ARG POSTGRES_VERSION=17

USER root

# Install all dependencies and extensions in one layer
RUN <<EOT
  set -eux

  # Update package list
  apt-get update

  # Install build dependencies and tools
  apt-get install -y --no-install-recommends \
    curl \
    gnupg \
    lsb-release \
    ca-certificates

  # Get OS version
  . /etc/os-release 2>/dev/null

  # Add TimescaleDB repository
  echo "deb https://packagecloud.io/timescale/timescaledb/debian/ ${VERSION_CODENAME} main" > /etc/apt/sources.list.d/timescaledb.list
  curl -Lsf https://packagecloud.io/timescale/timescaledb/gpgkey | gpg --dearmor > /etc/apt/trusted.gpg.d/timescale.gpg

  # Add PostgreSQL repository
  curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc | gpg --dearmor -o /etc/apt/trusted.gpg.d/postgresql.gpg
  echo "deb http://apt.postgresql.org/pub/repos/apt ${VERSION_CODENAME}-pgdg main" > /etc/apt/sources.list.d/pgdg.list

  # Update with new repositories
  apt-get update

  # Install PostGIS and TimescaleDB
  apt-get install -y --no-install-recommends \
    "timescaledb-2-postgresql-${POSTGRES_VERSION}" \
    "postgis" \
    "postgresql-postgis"
    #"postgresql-${POSTGRES_VERSION}-postgis-3" \
    #"postgresql-${POSTGRES_VERSION}-postgis-3-scripts"\

  # Cleanup
  apt-get purge -y curl gnupg lsb-release
  apt-get autoremove -y
  rm -rf /etc/apt/sources.list.d/timescaledb.list /etc/apt/sources.list.d/pgdg.list
  rm -rf /etc/apt/trusted.gpg.d/timescale.gpg /etc/apt/trusted.gpg.d/postgresql.gpg
  rm -rf /var/cache/apt/*
  rm -rf /var/lib/apt/lists/*
EOT

# Switch back to postgres user for CloudNativePG compatibility
USER 26

# Labels for documentation
LABEL org.opencontainers.image.title="PostgreSQL 17 with TimescaleDB and PostGIS"
LABEL org.opencontainers.image.description="CloudNativePG PostgreSQL 18.1 with TimescaleDB 2.25.1 and PostGIS 3.x built-in"
LABEL org.opencontainers.image.version="17-timescale2.25.1-postgis3.x"
LABEL org.opencontainers.image.source="https://github.com/cloudnative-pg/postgresql"
