/**
 * Runtime Configuration
 * 
 * This file is generated at container startup by docker-entrypoint.sh
 * using environment variables from the Kubernetes ConfigMap.
 * 
 * DO NOT EDIT THIS FILE DIRECTLY - it will be overwritten on container restart.
 */
window.__CONFIG__ = {
  apiBaseUrl: "${API_BASE_URL}",
  wsUrl: "${WS_URL}",
  useMocks: ${USE_MOCKS:-false},
  firebaseConfig: {
    apiKey: "${FIREBASE_API_KEY}",
    authDomain: "${FIREBASE_AUTH_DOMAIN}",
    projectId: "${FIREBASE_PROJECT_ID}",
    storageBucket: "${FIREBASE_STORAGE_BUCKET}",
    messagingSenderId: "${FIREBASE_MESSAGING_SENDER_ID}",
    appId: "${FIREBASE_APP_ID}"
  },
  firebaseVapidKey: "${FIREBASE_VAPID_KEY}"
};
