# ===========================================
# Vlettenrally App - Development Environment
# ===========================================
# Copy this file to .env and adjust as needed

# Enable mock mode for development without backend
# Set to 'true' to use mock data, 'false' or remove to use real API
VITE_USE_MOCKS=false

# Backend API URL (only used when VITE_USE_MOCKS is not 'true')
VITE_API_URL=http://localhost:8080/api/v1

# WebSocket URL for real-time updates
VITE_WS_URL=ws://localhost:8080/ws

# Map style URL (public OpenFreeMap style for development, no tileserver needed)
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Firebase configuration for push notifications
